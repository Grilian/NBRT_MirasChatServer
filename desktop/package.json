{
  "name": "miraschat-desktop",
  "version": "1.10.4",
  "releaseVersion": "1.10.4",
  "buildVersion": "1.10.4",
  "private": true,
  "description": "MirasChat — десктопный клиент для Windows и Linux",
  "main": "src/main.js",
  "author": "MIRAS",
  "homepage": "https://cagrizzz.ru/miraschat/",
  "scripts": {
    "gen-icons": "node scripts/gen-icons.js",
    "build:client": "node scripts/build-client.js",
    "prepare-app": "npm run gen-icons && npm run build:client",
    "start": "electron .",
    "dist:win": "npm run prepare-app && electron-builder --win --x64",
    "dist:linux": "npm run prepare-app && electron-builder --linux --x64"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5",
    "to-ico": "^1.1.5"
  },
  "build": {
    "appId": "ru.miras.mirasChat",
    "productName": "MirasChat",
    "compression": "store",
    "detectUpdateChannel": false,
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Network;InstantMessaging;",
      "synopsis": "Корпоративный мессенджер MIRAS",
      "description": "MirasChat — корпоративный мессенджер: переписка, группы, задачи, календарь.",
      "maintainer": "MIRAS <cagrizzzca@gmail.com>",
      "desktop": {
        "Name": "MirasChat",
        "Comment": "Корпоративный мессенджер MIRAS",
        "Keywords": "chat;messenger;мессенджер;чат;",
        "StartupWMClass": "MirasChat"
      }
    },
    "deb": {
      "artifactName": "MirasChat_${version}_${arch}.${ext}",
      "priority": "optional",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0",
        "libuuid1"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://cagrizzz.ru/miraschat/updates/"
      }
    ],
    "nsis": {
      "artifactName": "MirasChat Setup ${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MirasChat"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
